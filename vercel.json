{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "genesis-hazel-one.vercel.app"
        }
      ],
      "destination": "https://questit.vesit.ves.ac.in/genesis/$1",
      "permanent": true
    }
  ]
}